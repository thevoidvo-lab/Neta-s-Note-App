<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <com.example.notesapp.ui.CanvasView
        android:id="@+id/canvasView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/surface" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="horizontal"
        android:background="@color/surface"
        android:elevation="4dp"
        android:padding="12dp"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="@color/text_primary" />

        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

        <ImageView
            android:id="@+id/btnUndo"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginEnd="16dp"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="@color/text_secondary" />

        <ImageView
            android:id="@+id/btnRedo"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginEnd="16dp"
            android:scaleX="-1"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="@color/text_secondary" />

        <ImageView
            android:id="@+id/btnCanvasSettings"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginEnd="16dp"
            android:src="@android:drawable/ic_menu_preferences"
            app:tint="@color/text_secondary" />

        <ImageView
            android:id="@+id/btnSave"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@android:drawable/ic_menu_save"
            app:tint="@color/primary" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:background="@drawable/bg_bottom_sheet"
        android:elevation="8dp"
        android:padding="12dp"
        android:gravity="center">

        <LinearLayout android:id="@+id/toolAddElement" style="@style/EditorTool">
            <ImageView style="@style/EditorToolIcon" android:src="@android:drawable/ic_input_add" />
            <TextView style="@style/EditorToolLabel" android:text="Element" />
        </LinearLayout>

        <LinearLayout android:id="@+id/toolFont" style="@style/EditorTool">
            <ImageView style="@style/EditorToolIcon" android:src="@android:drawable/ic_menu_edit" />
            <TextView style="@style/EditorToolLabel" android:text="Font" />
        </LinearLayout>

        <LinearLayout android:id="@+id/toolColor" style="@style/EditorTool">
            <ImageView style="@style/EditorToolIcon" android:src="@android:drawable/ic_menu_gallery" />
            <TextView style="@style/EditorToolLabel" android:text="Color" />
        </LinearLayout>

        <LinearLayout android:id="@+id/toolBackground" style="@style/EditorTool">
            <ImageView style="@style/EditorToolIcon" android:src="@android:drawable/ic_menu_crop" />
            <TextView style="@style/EditorToolLabel" android:text="BG" />
        </LinearLayout>

        <LinearLayout android:id="@+id/toolSticker" style="@style/EditorTool">
            <ImageView style="@style/EditorToolIcon" android:src="@android:drawable/ic_menu_camera" />
            <TextView style="@style/EditorToolLabel" android:text="Sticker" />
        </LinearLayout>

        <LinearLayout android:id="@+id/toolLayer" style="@style/EditorTool">
            <ImageView style="@style/EditorToolIcon" android:src="@android:drawable/ic_menu_sort_by_size" />
            <TextView style="@style/EditorToolLabel" android:text="Layer" />
        </LinearLayout>

    </LinearLayout>

</FrameLayout>
