<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <application
        android:name=".util.NetaApp"
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher_default"
        android:label="@string/app_name"
        android:theme="@style/Theme.NetaNotes"
        android:supportsRtl="true">

        <!-- MainActivity sengaja TANPA intent-filter LAUNCHER di sini -->
        <!-- biar gak dobel sama activity-alias di bawah (yang jadi pintu masuk ikon custom) -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:theme="@style/Theme.NetaNotes" />

        <activity android:name=".ui.NoteListActivity" android:exported="false" />
        <activity android:name=".ui.NoteEditActivity" android:exported="false" />
        <activity android:name=".ui.SettingsActivity" android:exported="false" />
        <activity android:name=".ui.JsonTransferActivity" android:exported="false" />

        <!-- Activity-alias buat 6 preset icon, semua nunjuk ke MainActivity -->
        <activity-alias
            android:name=".IconDefault"
            android:enabled="true"
            android:exported="true"
            android:icon="@drawable/ic_launcher_default"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".IconDark"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/ic_launcher_dark"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".IconPastel"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/ic_launcher_pastel"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".IconNeon"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/ic_launcher_neon"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".IconMinimal"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/ic_launcher_minimal"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".IconGold"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/ic_launcher_gold"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

    </application>

</manifest>
